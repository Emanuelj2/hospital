@page "/admin/employees"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Json.Serialization
@using hospital.application.DTOs
@using hospital.domain.Enums
@using hoapital.ui.Auth
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@inject AuthTokenProvider AuthTokenProvider
@rendermode InteractiveServer

<div class="dash-page">
    <PageHeader />

    <div class="admin-body">
        <a class="admin-breadcrumb" href="/dashboard">&larr; Back to Dashboard</a>
        <div class="dash-heading">Employees</div>
        <div class="dash-subtitle">Manage staff records and provision staff logins.</div>

        @if (errorMessage != null)
        {
            <div class="auth-alert">@errorMessage</div>
        }

        @if (successMessage != null)
        {
            <div class="auth-alert auth-alert-success">@successMessage</div>
        }

        <div class="admin-card">
            @if (employees == null)
            {
                <div class="admin-empty">Loading...</div>
            }
            else if (employees.Count == 0)
            {
                <div class="admin-empty">No employees yet — add one below.</div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Job</th>
                                <th>Department</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in employees)
                            {
                                <tr>
                                    <td>@employee.FirstName @employee.LastName</td>
                                    <td>@employee.Email</td>
                                    <td><span class="admin-badge">@employee.Job</span></td>
                                    <td>@DepartmentName(employee.DepartmentId)</td>
                                    <td>
                                        <button class="admin-btn admin-btn-edit" @onclick="() => EditEmployee(employee)">Edit</button>
                                        <button class="admin-btn admin-btn-delete" @onclick="() => DeleteEmployee(employee.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="admin-card">
            <div class="admin-card-heading">@(editingId == null ? "Add New Employee" : $"Editing Employee #{editingId}")</div>

            <EditForm Model="formModel" OnValidSubmit="SaveEmployee" FormName="employeeForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="admin-form-grid">
                    <div class="admin-field">
                        <label>First Name</label>
                        <InputText class="form-control" @bind-Value="formModel.FirstName" />
                    </div>

                    <div class="admin-field">
                        <label>Last Name</label>
                        <InputText class="form-control" @bind-Value="formModel.LastName" />
                    </div>

                    <div class="admin-field">
                        <label>Email</label>
                        <InputText class="form-control" @bind-Value="formModel.Email" />
                    </div>

                    <div class="admin-field">
                        <label>Phone Number</label>
                        <InputText class="form-control" @bind-Value="formModel.PhoneNumber" />
                    </div>

                    <div class="admin-field">
                        <label>Date of Birth</label>
                        <InputDate class="form-control" @bind-Value="formModel.DateOfBirth" />
                    </div>

                    <div class="admin-field">
                        <label>State Licence Number</label>
                        <InputText class="form-control" @bind-Value="formModel.StateLicenceNumber" />
                    </div>

                    <div class="admin-field">
                        <label>Salary</label>
                        <InputNumber class="form-control" @bind-Value="formModel.Salary" />
                    </div>

                    <div class="admin-field">
                        <label>Hire Date</label>
                        <InputDate class="form-control" @bind-Value="formModel.HireDate" />
                    </div>

                    <div class="admin-field">
                        <label>Job</label>
                        <InputSelect class="form-select" @bind-Value="formModel.Job">
                            @foreach (var job in Enum.GetValues<JobTitle>())
                            {
                                <option value="@job">@job</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="admin-field">
                        <label>Department</label>
                        <select class="form-select" @bind="departmentIdValue">
                            <option value="">(none)</option>
                            @if (departments != null)
                            {
                                @foreach (var department in departments)
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            }
                        </select>
                    </div>

                    @if (editingId == null)
                    {
                        <div class="admin-field">
                            <label>Password</label>
                            <InputText type="password" class="form-control" @bind-Value="password" />
                        </div>

                        <div class="admin-field">
                            <label>Role</label>
                            <InputSelect class="form-select" @bind-Value="role">
                                <option value="Employee">Employee</option>
                                <option value="Doctor">Doctor</option>
                                <option value="Admin">Admin</option>
                            </InputSelect>
                        </div>
                    }
                </div>

                <button type="submit" class="admin-btn admin-btn-primary">Save</button>
                @if (editingId != null)
                {
                    <button type="button" class="admin-btn admin-btn-cancel" @onclick="CancelEdit">Cancel</button>
                }
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<EmployeeDto>? employees;
    private List<DepartmentDto>? departments;
    private EmployeeDto formModel = new();
    private string password = string.Empty;
    private string role = "Employee";
    private int? editingId;
    private string? errorMessage;
    private string? successMessage;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerOptions.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private string departmentIdValue
    {
        get => formModel.DepartmentId == 0 ? string.Empty : formModel.DepartmentId.ToString();
        set => formModel.DepartmentId = string.IsNullOrEmpty(value) ? 0 : int.Parse(value);
    }

    // Not OnInitializedAsync — this component's first render happens during Blazor's static
    // SSR pass, before the interactive circuit (and its JS interop) exists. The auth token
    // lives in protected session storage, which needs that interop.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadEmployees();
            await LoadDepartments();
            StateHasChanged();
        }
    }

    private async Task<HttpClient> CreateAuthorizedClientAsync()
    {
        var client = ClientFactory.CreateClient("HospitalAPI");
        var token = await AuthTokenProvider.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task LoadEmployees()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            employees = await client.GetFromJsonAsync<List<EmployeeDto>>("api/employee", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load employees: {ex.Message}";
        }
    }

    private async Task LoadDepartments()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            departments = await client.GetFromJsonAsync<List<DepartmentDto>>("api/department", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load departments: {ex.Message}";
        }
    }

    private string DepartmentName(int? departmentId) =>
        departments?.FirstOrDefault(d => d.Id == departmentId)?.Name ?? "-";

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackPrefix)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiErrorResponse>(JsonOptions);
            if (!string.IsNullOrWhiteSpace(problem?.Message))
            {
                return problem.Message;
            }
        }
        catch (JsonException)
        {
            // Not a { "message": "..." } body — fall through to the generic message.
        }

        return $"{fallbackPrefix}: {response.StatusCode}";
    }

    private record ApiErrorResponse(string? Message);

    private void EditEmployee(EmployeeDto employee)
    {
        editingId = employee.Id;
        formModel = new EmployeeDto
        {
            Id = employee.Id,
            FirstName = employee.FirstName,
            MiddleName = employee.MiddleName,
            LastName = employee.LastName,
            Email = employee.Email,
            PhoneNumber = employee.PhoneNumber,
            DateOfBirth = employee.DateOfBirth,
            StateLicenceNumber = employee.StateLicenceNumber,
            Salary = employee.Salary,
            HireDate = employee.HireDate,
            Job = employee.Job,
            EmploymentType = employee.EmploymentType,
            AccessLevel = employee.AccessLevel,
            DepartmentId = employee.DepartmentId,
            Pronoun = employee.Pronoun
        };
    }

    private void CancelEdit()
    {
        editingId = null;
        formModel = new EmployeeDto();
        password = string.Empty;
        role = "Employee";
    }

    private async Task SaveEmployee()
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;
        successMessage = null;

        try
        {
            if (editingId == null)
            {
                var request = new CreateStaffAccountDto
                {
                    Employee = formModel,
                    Password = password,
                    Role = role
                };
                var response = await client.PostAsJsonAsync("api/employee/with-account", request, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await ExtractErrorMessageAsync(response, "Create failed");
                    return;
                }
                successMessage = $"Employee created with a {role} login for {formModel.Email}.";
            }
            else
            {
                var response = await client.PutAsJsonAsync($"api/employee/{editingId}", formModel, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Update failed: {response.StatusCode}";
                    return;
                }
            }

            formModel = new EmployeeDto();
            password = string.Empty;
            role = "Employee";
            editingId = null;
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
    }

    private async Task DeleteEmployee(int id)
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;
        try
        {
            var response = await client.DeleteAsync($"api/employee/{id}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ExtractErrorMessageAsync(response, "Delete failed");
                return;
            }
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage = $"Delete failed: {ex.Message}";
        }
    }
}
