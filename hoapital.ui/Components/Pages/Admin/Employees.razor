@page "/admin/employees"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Json.Serialization
@using hospital.application.DTOs
@using hospital.domain.Enums
@using hoapital.ui.Auth
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@inject AuthTokenProvider AuthTokenProvider
@rendermode InteractiveServer

<div class="dash-page">
    <PageHeader />

    <div class="admin-body">
        <a class="admin-breadcrumb" href="/dashboard">&larr; Back to Dashboard</a>
        <div class="dash-heading">Employees</div>
        <div class="dash-subtitle">Manage staff records and provision staff logins.</div>

        @if (errorMessage != null)
        {
            <div class="auth-alert">@errorMessage</div>
        }

        @if (successMessage != null)
        {
            <div class="auth-alert auth-alert-success">@successMessage</div>
        }

        <div class="admin-card">
            <div class="admin-tabs">
                <button class="admin-tab @(activeTab == "list" ? "active" : "")" @onclick='() => SwitchTab("list")'>All Employees</button>
                <button class="admin-tab @(activeTab == "form" ? "active" : "")" @onclick='() => SwitchTab("form")'>@(editingId == null ? "Add New Employee" : $"Editing Employee #{editingId}")</button>
            </div>

            @if (activeTab == "list")
            {
                @if (employees == null)
                {
                    <div class="admin-empty">Loading...</div>
                }
                else if (employees.Count == 0)
                {
                    <div class="admin-empty">No employees yet — add one from the tab above.</div>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Job</th>
                                    <th>Department</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var employee in employees)
                                {
                                    <tr @onclick="() => ShowDetails(employee)">
                                        <td>@employee.FirstName @employee.LastName</td>
                                        <td>@employee.Email</td>
                                        <td><span class="admin-badge">@employee.Job</span></td>
                                        <td>@DepartmentName(employee.DepartmentId)</td>
                                        <td>
                                            <button class="admin-btn admin-btn-edit" @onclick="() => EditEmployee(employee)" @onclick:stopPropagation="true">Edit</button>
                                            <button class="admin-btn admin-btn-delete" @onclick="() => DeleteEmployee(employee.Id)" @onclick:stopPropagation="true">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <EditForm Model="formModel" OnValidSubmit="SaveEmployee" FormName="employeeForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="admin-form-grid">
                        <div class="admin-field">
                            <label>First Name</label>
                            <InputText class="form-control" @bind-Value="formModel.FirstName" />
                        </div>

                        <div class="admin-field">
                            <label>Last Name</label>
                            <InputText class="form-control" @bind-Value="formModel.LastName" />
                        </div>

                        <div class="admin-field">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="formModel.Email" />
                        </div>

                        <div class="admin-field">
                            <label>Phone Number</label>
                            <InputText class="form-control" @bind-Value="formModel.PhoneNumber" />
                        </div>

                        <div class="admin-field">
                            <label>Date of Birth</label>
                            <InputDate class="form-control" @bind-Value="formModel.DateOfBirth" />
                        </div>

                        <div class="admin-field">
                            <label>State Licence Number</label>
                            <InputText class="form-control" @bind-Value="formModel.StateLicenceNumber" />
                        </div>

                        <div class="admin-field">
                            <label>Salary</label>
                            <InputNumber class="form-control" @bind-Value="formModel.Salary" />
                        </div>

                        <div class="admin-field">
                            <label>Hire Date</label>
                            <InputDate class="form-control" @bind-Value="formModel.HireDate" />
                        </div>

                        <div class="admin-field">
                            <label>Job</label>
                            <InputSelect class="form-select" @bind-Value="formModel.Job">
                                @foreach (var job in Enum.GetValues<JobTitle>())
                                {
                                    <option value="@job">@job</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="admin-field">
                            <label>Seniority Level</label>
                            <InputSelect class="form-select" @bind-Value="formModel.AccessLevel">
                                @foreach (var level in Enum.GetValues<AccessLevelType>())
                                {
                                    <option value="@level">@level</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="admin-field">
                            <label>Department</label>
                            <select class="form-select" @bind="departmentIdValue">
                                <option value="">(none)</option>
                                @if (departments != null)
                                {
                                    @foreach (var department in departments)
                                    {
                                        <option value="@department.Id">@department.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @if (editingId == null)
                        {
                            <div class="admin-field">
                                <label>Password</label>
                                <InputText type="password" class="form-control" @bind-Value="password" />
                            </div>

                            <div class="admin-field">
                                <label>Role</label>
                                <InputSelect class="form-select" @bind-Value="role">
                                    <option value="Employee">Employee</option>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Admin">Admin</option>
                                </InputSelect>
                            </div>
                        }
                        else if (editingHasAccount)
                        {
                            <div class="admin-field">
                                <label>Role</label>
                                <InputSelect class="form-select" @bind-Value="role">
                                    <option value="Employee">Employee</option>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Admin">Admin</option>
                                </InputSelect>
                            </div>
                        }
                    </div>

                    <button type="submit" class="admin-btn admin-btn-primary">Save</button>
                    @if (editingId != null)
                    {
                        <button type="button" class="admin-btn admin-btn-cancel" @onclick="CancelEdit">Cancel</button>
                    }
                </EditForm>
            }
        </div>
    </div>
</div>

@if (selectedEmployee != null)
{
    <div class="admin-modal-backdrop" @onclick="CloseDetails">
        <div class="admin-modal" @onclick:stopPropagation="true">
            <div class="admin-modal-topbar"></div>
            <div class="admin-modal-header">
                <div>
                    <div class="admin-modal-title">@selectedEmployee.FirstName @selectedEmployee.LastName</div>
                    <div class="admin-modal-subtitle">@selectedEmployee.Job &middot; @DepartmentName(selectedEmployee.DepartmentId)</div>
                </div>
                <button class="admin-modal-close" @onclick="CloseDetails">&times;</button>
            </div>
            <div class="admin-modal-body">
                <div class="admin-detail-section-title">Contact</div>
                <div class="admin-detail-grid">
                    <div class="admin-detail-item"><label>Email</label><div class="value">@selectedEmployee.Email</div></div>
                    <div class="admin-detail-item"><label>Phone</label><div class="value">@selectedEmployee.PhoneNumber</div></div>
                    <div class="admin-detail-item"><label>Date of Birth</label><div class="value">@selectedEmployee.DateOfBirth.ToString("yyyy-MM-dd")</div></div>
                    <div class="admin-detail-item"><label>Address</label><div class="value">@FormatAddress(selectedEmployee)</div></div>
                </div>

                <div class="admin-detail-section-title">Employment</div>
                <div class="admin-detail-grid">
                    <div class="admin-detail-item"><label>Job Title</label><div class="value">@selectedEmployee.Job</div></div>
                    <div class="admin-detail-item"><label>Department</label><div class="value">@DepartmentName(selectedEmployee.DepartmentId)</div></div>
                    <div class="admin-detail-item"><label>Employment Type</label><div class="value">@selectedEmployee.EmploymentType</div></div>
                    <div class="admin-detail-item"><label>Hire Date</label><div class="value">@selectedEmployee.HireDate.ToString("yyyy-MM-dd")</div></div>
                    <div class="admin-detail-item"><label>Salary</label><div class="value">@selectedEmployee.Salary.ToString("C")</div></div>
                    <div class="admin-detail-item"><label>State Licence #</label><div class="value">@(string.IsNullOrEmpty(selectedEmployee.StateLicenceNumber) ? "—" : selectedEmployee.StateLicenceNumber)</div></div>
                    <div class="admin-detail-item"><label>Seniority Level</label><div class="value">@selectedEmployee.AccessLevel</div></div>
                </div>

                <div class="admin-detail-section-title">Access &amp; Permissions</div>
                <div class="admin-detail-grid">
                    <div class="admin-detail-item"><label>Login Account</label><div class="value">@(selectedEmployee.UserAccountId != null ? "Provisioned" : "None")</div></div>
                    <div class="admin-detail-item"><label>Role</label><div class="value">@(selectedEmployee.Role ?? "—")</div></div>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-edit" @onclick="() => { EditEmployee(selectedEmployee); CloseDetails(); }">Edit</button>
                <button class="admin-btn admin-btn-cancel" @onclick="CloseDetails">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<EmployeeDto>? employees;
    private List<DepartmentDto>? departments;
    private EmployeeDto formModel = new();
    private EmployeeDto? selectedEmployee;
    private string password = string.Empty;
    private string role = "Employee";
    private bool editingHasAccount;
    private int? editingId;
    private string activeTab = "list";
    private string? errorMessage;
    private string? successMessage;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerOptions.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private string departmentIdValue
    {
        get => formModel.DepartmentId == 0 ? string.Empty : formModel.DepartmentId.ToString();
        set => formModel.DepartmentId = string.IsNullOrEmpty(value) ? 0 : int.Parse(value);
    }

    private void SwitchTab(string tab) => activeTab = tab;

    // Not OnInitializedAsync — this component's first render happens during Blazor's static
    // SSR pass, before the interactive circuit (and its JS interop) exists. The auth token
    // lives in protected session storage, which needs that interop.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadEmployees();
            await LoadDepartments();
            StateHasChanged();
        }
    }

    private async Task<HttpClient> CreateAuthorizedClientAsync()
    {
        var client = ClientFactory.CreateClient("HospitalAPI");
        var token = await AuthTokenProvider.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task LoadEmployees()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            employees = await client.GetFromJsonAsync<List<EmployeeDto>>("api/employee", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load employees: {ex.Message}";
        }
    }

    private async Task LoadDepartments()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            departments = await client.GetFromJsonAsync<List<DepartmentDto>>("api/department", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load departments: {ex.Message}";
        }
    }

    private string DepartmentName(int? departmentId) =>
        departments?.FirstOrDefault(d => d.Id == departmentId)?.Name ?? "-";

    private static string FormatAddress(EmployeeDto employee)
    {
        var parts = new[] { employee.Address, employee.City, employee.State, employee.ZipCode, employee.Country }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var joined = string.Join(", ", parts);
        return string.IsNullOrEmpty(joined) ? "—" : joined;
    }

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackPrefix)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiErrorResponse>(JsonOptions);
            if (!string.IsNullOrWhiteSpace(problem?.Message))
            {
                return problem.Message;
            }
        }
        catch (JsonException)
        {
            // Not a { "message": "..." } body — fall through to the generic message.
        }

        return $"{fallbackPrefix}: {response.StatusCode}";
    }

    private record ApiErrorResponse(string? Message);

    private void ShowDetails(EmployeeDto employee) => selectedEmployee = employee;

    private void CloseDetails() => selectedEmployee = null;

    private void EditEmployee(EmployeeDto employee)
    {
        editingId = employee.Id;
        formModel = new EmployeeDto
        {
            Id = employee.Id,
            FirstName = employee.FirstName,
            MiddleName = employee.MiddleName,
            LastName = employee.LastName,
            Email = employee.Email,
            PhoneNumber = employee.PhoneNumber,
            DateOfBirth = employee.DateOfBirth,
            StateLicenceNumber = employee.StateLicenceNumber,
            Salary = employee.Salary,
            HireDate = employee.HireDate,
            Job = employee.Job,
            EmploymentType = employee.EmploymentType,
            AccessLevel = employee.AccessLevel,
            DepartmentId = employee.DepartmentId,
            Pronoun = employee.Pronoun
        };
        editingHasAccount = employee.UserAccountId != null;
        role = employee.Role ?? "Employee";
        activeTab = "form";
    }

    private void CancelEdit()
    {
        editingId = null;
        formModel = new EmployeeDto();
        password = string.Empty;
        role = "Employee";
        editingHasAccount = false;
        activeTab = "list";
    }

    private async Task SaveEmployee()
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;
        successMessage = null;

        try
        {
            if (editingId == null)
            {
                var request = new CreateStaffAccountDto
                {
                    Employee = formModel,
                    Password = password,
                    Role = role
                };
                var response = await client.PostAsJsonAsync("api/employee/with-account", request, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await ExtractErrorMessageAsync(response, "Create failed");
                    return;
                }
                successMessage = $"Employee created with a {role} login for {formModel.Email}.";
            }
            else
            {
                var response = await client.PutAsJsonAsync($"api/employee/{editingId}", formModel, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Update failed: {response.StatusCode}";
                    return;
                }

                if (editingHasAccount)
                {
                    var roleResponse = await client.PutAsJsonAsync($"api/employee/{editingId}/role", new UpdateRoleDto { Role = role }, JsonOptions);
                    if (!roleResponse.IsSuccessStatusCode)
                    {
                        errorMessage = await ExtractErrorMessageAsync(roleResponse, "Employee saved, but role update failed");
                        await LoadEmployees();
                        return;
                    }
                }
            }

            formModel = new EmployeeDto();
            password = string.Empty;
            role = "Employee";
            editingHasAccount = false;
            editingId = null;
            activeTab = "list";
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
    }

    private async Task DeleteEmployee(int id)
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;
        try
        {
            var response = await client.DeleteAsync($"api/employee/{id}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ExtractErrorMessageAsync(response, "Delete failed");
                return;
            }
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage = $"Delete failed: {ex.Message}";
        }
    }
}
