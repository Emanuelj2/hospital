@page "/admin/departments"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text.Json.Serialization
@using hospital.application.DTOs
@using hoapital.ui.Auth
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@inject AuthTokenProvider AuthTokenProvider
@rendermode InteractiveServer

<div class="dash-page">
    <PageHeader />

    <div class="admin-body">
        <a class="admin-breadcrumb" href="/dashboard">&larr; Back to Dashboard</a>
        <div class="dash-heading">Departments</div>
        <div class="dash-subtitle">Manage hospital departments and assign a head for each.</div>

        @if (errorMessage != null)
        {
            <div class="auth-alert">@errorMessage</div>
        }

        <div class="admin-card">
            <div class="admin-tabs">
                <button class="admin-tab @(activeTab == "list" ? "active" : "")" @onclick='() => SwitchTab("list")'>All Departments</button>
                <button class="admin-tab @(activeTab == "form" ? "active" : "")" @onclick='() => SwitchTab("form")'>@(editingId == null ? "Add New Department" : $"Editing Department #{editingId}")</button>
            </div>

            @if (activeTab == "list")
            {
                @if (departments == null)
                {
                    <div class="admin-empty">Loading...</div>
                }
                else if (departments.Count == 0)
                {
                    <div class="admin-empty">No departments yet — add one from the tab above.</div>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Location</th>
                                    <th>Head</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var department in departments)
                                {
                                    <tr @onclick="() => ShowDetails(department)">
                                        <td>@department.Name</td>
                                        <td>@department.Location</td>
                                        <td>
                                            @if (department.HeadEmployeeName != null)
                                            {
                                                @department.HeadEmployeeName
                                            }
                                            else
                                            {
                                                <span class="admin-muted">&ndash;</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="admin-btn admin-btn-edit" @onclick="() => EditDepartment(department)" @onclick:stopPropagation="true">Edit</button>
                                            <button class="admin-btn admin-btn-delete" @onclick="() => DeleteDepartment(department.Id)" @onclick:stopPropagation="true">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <EditForm Model="formModel" OnValidSubmit="SaveDepartment" FormName="departmentForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="admin-form-grid">
                        <div class="admin-field">
                            <label>Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                        </div>

                        <div class="admin-field">
                            <label>Location</label>
                            <InputText class="form-control" @bind-Value="formModel.Location" />
                        </div>

                        <div class="admin-field">
                            <label>Head Employee</label>
                            <select class="form-select" @bind="headEmployeeIdValue">
                                <option value="">(none)</option>
                                @if (employees != null)
                                {
                                    @foreach (var employee in employees)
                                    {
                                        <option value="@employee.Id">@employee.FirstName @employee.LastName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="admin-btn admin-btn-primary">Save</button>
                    @if (editingId != null)
                    {
                        <button type="button" class="admin-btn admin-btn-cancel" @onclick="CancelEdit">Cancel</button>
                    }
                </EditForm>
            }
        </div>
    </div>
</div>

@if (selectedDepartment != null)
{
    <div class="admin-modal-backdrop" @onclick="CloseDetails">
        <div class="admin-modal" @onclick:stopPropagation="true">
            <div class="admin-modal-topbar"></div>
            <div class="admin-modal-header">
                <div>
                    <div class="admin-modal-title">@selectedDepartment.Name</div>
                    <div class="admin-modal-subtitle">Department #@selectedDepartment.Id</div>
                </div>
                <button class="admin-modal-close" @onclick="CloseDetails">&times;</button>
            </div>
            <div class="admin-modal-body">
                <div class="admin-detail-grid">
                    <div class="admin-detail-item">
                        <label>Location</label>
                        <div class="value">@selectedDepartment.Location</div>
                    </div>
                    <div class="admin-detail-item">
                        <label>Head Employee</label>
                        <div class="value">@(selectedDepartment.HeadEmployeeName ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-edit" @onclick="() => { EditDepartment(selectedDepartment); CloseDetails(); }">Edit</button>
                <button class="admin-btn admin-btn-cancel" @onclick="CloseDetails">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartmentDto>? departments;
    private List<EmployeeDto>? employees;
    private DepartmentDto formModel = new();
    private DepartmentDto? selectedDepartment;
    private int? editingId;
    private string activeTab = "list";
    private string? errorMessage;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerOptions.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private string headEmployeeIdValue
    {
        get => formModel.HeadEmployeeId?.ToString() ?? string.Empty;
        set => formModel.HeadEmployeeId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    private void SwitchTab(string tab) => activeTab = tab;

    // Not OnInitializedAsync — this component's first render happens during Blazor's static
    // SSR pass, before the interactive circuit (and its JS interop) exists. The auth token
    // lives in protected session storage, which needs that interop.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDepartments();
            await LoadEmployees();
            StateHasChanged();
        }
    }

    private async Task<HttpClient> CreateAuthorizedClientAsync()
    {
        var client = ClientFactory.CreateClient("HospitalAPI");
        var token = await AuthTokenProvider.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        return client;
    }

    private async Task LoadDepartments()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            departments = await client.GetFromJsonAsync<List<DepartmentDto>>("api/department", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load departments: {ex.Message}";
        }
    }

    private async Task LoadEmployees()
    {
        var client = await CreateAuthorizedClientAsync();
        try
        {
            employees = await client.GetFromJsonAsync<List<EmployeeDto>>("api/employee", JsonOptions);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load employees: {ex.Message}";
        }
    }

    private static async Task<string> ExtractErrorMessageAsync(HttpResponseMessage response, string fallbackPrefix)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiErrorResponse>(JsonOptions);
            if (!string.IsNullOrWhiteSpace(problem?.Message))
            {
                return problem.Message;
            }
        }
        catch (JsonException)
        {
            // Not a { "message": "..." } body — fall through to the generic message.
        }

        return $"{fallbackPrefix}: {response.StatusCode}";
    }

    private record ApiErrorResponse(string? Message);

    private void ShowDetails(DepartmentDto department) => selectedDepartment = department;

    private void CloseDetails() => selectedDepartment = null;

    private void EditDepartment(DepartmentDto department)
    {
        editingId = department.Id;
        formModel = new DepartmentDto
        {
            Id = department.Id,
            Name = department.Name,
            Location = department.Location,
            HeadEmployeeId = department.HeadEmployeeId
        };
        activeTab = "form";
    }

    private void CancelEdit()
    {
        editingId = null;
        formModel = new DepartmentDto();
        activeTab = "list";
    }

    private async Task SaveDepartment()
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;

        try
        {
            if (editingId == null)
            {
                var response = await client.PostAsJsonAsync("api/department", formModel, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await ExtractErrorMessageAsync(response, "Create failed");
                    return;
                }
            }
            else
            {
                var response = await client.PutAsJsonAsync($"api/department/{editingId}", formModel, JsonOptions);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await ExtractErrorMessageAsync(response, "Update failed");
                    return;
                }
            }

            formModel = new DepartmentDto();
            editingId = null;
            activeTab = "list";
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
        }
    }

    private async Task DeleteDepartment(int id)
    {
        var client = await CreateAuthorizedClientAsync();
        errorMessage = null;
        try
        {
            var response = await client.DeleteAsync($"api/department/{id}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ExtractErrorMessageAsync(response, "Delete failed");
                return;
            }
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Delete failed: {ex.Message}";
        }
    }
}
