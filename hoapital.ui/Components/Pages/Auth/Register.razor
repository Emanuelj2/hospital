@page "/register"
@rendermode InteractiveServer
@layout BlankLayout
@using hospital.application.DTOs
@using hoapital.ui.Auth
@inject IHttpClientFactory ClientFactory
@inject CustomAuthStateProvider CustomAuthState
@inject NavigationManager Navigation

<HeadContent>
    <link href="css/auth.css" rel="stylesheet" />
</HeadContent>

<div class="auth-page">
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>
    <div class="auth-blob auth-blob-3"></div>

    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-brand-icon">+</div>
            <div>
                <div class="auth-brand-name">MediHealth</div>
                <div class="auth-brand-tag">STAFF PORTAL</div>
            </div>
        </div>

        <div class="auth-heading">Create your account</div>
        <div class="auth-subtitle">Register to get access to patient records and scheduling.</div>

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="registerForm">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <div class="auth-field-header">
                    <label>Email address</label>
                </div>
                <InputText class="form-control" @bind-Value="registerModel.Email" placeholder="staff@medihealth.com" />
            </div>

            <div class="auth-field">
                <div class="auth-field-header">
                    <label>Password</label>
                </div>
                <div class="auth-input-wrap">
                    <input class="auth-input" type="@(showPassword ? "text" : "password")"
                           value="@registerModel.Password"
                           @oninput="OnPasswordInput"
                           placeholder="At least 8 characters" />
                    <button type="button" class="auth-eye" @onclick="TogglePassword">
                        @(showPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <div class="auth-field">
                <div class="auth-field-header">
                    <label>Role</label>
                </div>
                <InputSelect class="form-select" @bind-Value="registerModel.Role">
                    <option value="">Select a role</option>
                    <option value="Employee">Employee</option>
                    <option value="Doctor">Doctor</option>
                    <option value="Patient">Patient</option>
                    <option value="Visitor">Visitor</option>
                </InputSelect>
            </div>

            @if (errorMessage != null)
            {
                <div class="auth-alert">@errorMessage</div>
            }

            @if (successMessage != null)
            {
                <div class="auth-alert auth-alert-success">@successMessage</div>
            }

            <button type="submit" class="auth-submit" disabled="@isSubmitting">
                @(isSubmitting ? "Creating account..." : "Sign up")
            </button>
        </EditForm>

        <div class="auth-divider">or</div>

        <button type="button" class="auth-secondary">Sign up with hospital SSO</button>

        <div class="auth-secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            Secured with 256-bit SSL encryption
        </div>

        <div class="auth-footer">
            Already have an account? <a href="/login">Sign in</a>
        </div>
    </div>

    <div class="auth-copyright">© @DateTime.Now.Year MediHealth. All rights reserved.</div>
</div>

@code {
    private RegisterDto registerModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;
    private bool showPassword;

    private void TogglePassword() => showPassword = !showPassword;

    private void OnPasswordInput(ChangeEventArgs e) => registerModel.Password = e.Value?.ToString() ?? string.Empty;

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var client = ClientFactory.CreateClient("HospitalAPI");
            var response = await client.PostAsJsonAsync("api/auth/register", registerModel);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Registration failed. That email may already be in use.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();
            if (result == null)
            {
                errorMessage = "Registration failed. Please try again.";
                return;
            }

            await CustomAuthState.MarkUserAsAuthenticated(result.Token);
            successMessage = "Account created! Redirecting...";

            await Task.Delay(800);

            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Registration failed: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}