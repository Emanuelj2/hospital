@page "/"
@rendermode InteractiveServer
@layout BlankLayout
@using hospital.application.DTOs
@using hoapital.ui.Auth
@inject IHttpClientFactory ClientFactory
@inject CustomAuthStateProvider CustomAuthState
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<HeadContent>
    <link href="css/auth.css" rel="stylesheet" />
</HeadContent>

<div class="auth-page">
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>
    <div class="auth-blob auth-blob-3"></div>

    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-brand-icon">+</div>
            <div>
                <div class="auth-brand-name">MediHealth</div>
                <div class="auth-brand-tag">STAFF PORTAL</div>
            </div>
        </div>

        <div class="auth-heading">Welcome back</div>
        <div class="auth-subtitle">Sign in to access your patient records and schedule.</div>

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />

            @if (Env.IsDevelopment())
            {
                <div class="auth-quick-row">
                    <button type="button" class="auth-quick-btn" @onclick='() => FillDemoCredentials("Admin")'>Admin</button>
                    <button type="button" class="auth-quick-btn" @onclick='() => FillDemoCredentials("Doctor")'>Doctor</button>
                    <button type="button" class="auth-quick-btn" @onclick='() => FillDemoCredentials("Patient")'>Patient</button>
                </div>
            }

            <div class="auth-field">
                <div class="auth-field-header">
                    <label>Email address</label>
                </div>
                <InputText class="form-control" @bind-Value="loginModel.Email" placeholder="staff@medihealth.com" />
            </div>

            <div class="auth-field">
                <div class="auth-field-header">
                    <label>Password</label>
                    <a class="auth-link" href="/forgot-password">Forgot password?</a>
                </div>
                <div class="auth-input-wrap">
                    <input class="auth-input" type="@(showPassword ? "text" : "password")"
                           value="@loginModel.Password"
                           @oninput="OnPasswordInput"
                           placeholder="••••••••" />
                    <button type="button" class="auth-eye" @onclick="TogglePassword">
                        @(showPassword ? "Hide" : "Show")
                    </button>
                </div>
            </div>

            <div class="auth-checkbox-row">
                <input type="checkbox" id="keepSignedIn" @bind="keepSignedIn" />
                <label for="keepSignedIn">Keep me signed in</label>
            </div>

            @if (errorMessage != null)
            {
                <div class="auth-alert">@errorMessage</div>
            }

            <button type="submit" class="auth-submit" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in..." : "Sign in")
            </button>
        </EditForm>

        <div class="auth-divider">or</div>

        <button type="button" class="auth-secondary">Sign in with hospital SSO</button>

        @if (Env.IsDevelopment())
        {
            <button type="button" class="auth-secondary" @onclick="HandleSeedData" disabled="@isSeeding">
                @(isSeeding ? "Seeding..." : confirmingReset ? "Click again to erase & reseed" : "Seed Data")
            </button>

            @if (confirmingReset)
            {
                <div class="auth-alert">This will delete all existing data and replace it with seed data. Click "Seed Data" again to confirm.</div>
            }

            @if (seedMessage != null)
            {
                <div class="auth-alert auth-alert-success">@seedMessage</div>
            }
        }

        <div class="auth-secure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            Secured with 256-bit SSL encryption
        </div>

        <div class="auth-footer">
            Don't have an account? <a href="/register">Create one</a>
        </div>
    </div>

    <div class="auth-copyright">© @DateTime.Now.Year MediHealth. All rights reserved.</div>
</div>

@code {
    private LoginDto loginModel = new();
    private string? errorMessage;
    private string? seedMessage;
    private bool isSubmitting;
    private bool isSeeding;
    private bool confirmingReset;
    private bool showPassword;
    private bool keepSignedIn;

    private void TogglePassword() => showPassword = !showPassword;

    private void FillDemoCredentials(string role)
    {
        (loginModel.Email, loginModel.Password) = role switch
        {
            "Admin" => ("admin@medihealth.local", "Admin123!"),
            "Doctor" => ("doctor@medihealth.local", "Doctor123!"),
            "Patient" => ("patient@medihealth.local", "Patient123!"),
            _ => (loginModel.Email, loginModel.Password)
        };
        errorMessage = null;
    }

    private void OnPasswordInput(ChangeEventArgs e) => loginModel.Password = e.Value?.ToString() ?? string.Empty;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = ClientFactory.CreateClient("HospitalAPI");
            var response = await client.PostAsJsonAsync("api/auth/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Invalid email or password.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();
            if (result == null)
            {
                errorMessage = "Login failed. Please try again.";
                return;
            }

            await CustomAuthState.MarkUserAsAuthenticated(result.Token);

            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleSeedData()
    {
        if (!confirmingReset)
        {
            confirmingReset = true;
            seedMessage = null;
            errorMessage = null;
            return;
        }

        confirmingReset = false;
        isSeeding = true;
        seedMessage = null;
        errorMessage = null;

        try
        {
            var client = ClientFactory.CreateClient("HospitalAPI");
            var response = await client.PostAsync("api/seed", null);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Failed to seed data.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<SeedResultDto>();
            seedMessage = result?.Message ?? "Seed request completed.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Seed failed: {ex.Message}";
        }
        finally
        {
            isSeeding = false;
        }
    }
}