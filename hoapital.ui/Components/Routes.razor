@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.BlankLayout)">
            <NotAuthorized>
                <UnauthorizedAccess />
            </NotAuthorized>
            <Authorizing>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.BlankLayout)">
            <div class="status-page">
                <div class="status-blob status-blob-1"></div>
                <div class="status-blob status-blob-2"></div>

                <div class="status-card">
                    <div class="auth-brand" style="justify-content:center;">
                        <div class="auth-brand-icon">+</div>
                        <div>
                            <div class="auth-brand-name">MediHealth</div>
                            <div class="auth-brand-tag">STAFF PORTAL</div>
                        </div>
                    </div>

                    <div class="status-icon status-icon-muted">?</div>
                    <div class="status-title">Page not found</div>
                    <div class="status-text">
                        Sorry, there's nothing at this address.
                    </div>
                    <a class="auth-submit status-link" href="/">Back to login</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>